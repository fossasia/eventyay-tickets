#: eventyay/presale/templates/pretixpresale/event/order.html:389
msgid "Country"
msgstr "Estat"

#: eventyay/base/configurations/default_setting.py:819
msgid "Domestic tax ID"
msgstr "Identificació fiscal nacional"

#: eventyay/base/configurations/default_setting.py:820
msgid "e.g. tax number in Germany, ABN in Australia, …"
msgstr "p. ex., número fiscal a Alemanya, ABN a Austràlia, …"

#: eventyay/base/configurations/default_setting.py:829
msgid "EU VAT ID"
msgstr "Identificador d'IVA europeu"

#: eventyay/base/configurations/default_setting.py:842
msgid "e.g. With this document, we sent you the invoice for your ticket order."
msgstr ""
"és a dir, amb aquest document us enviem la factura per la vostra comanda del "
"tiquet."

#: eventyay/base/configurations/default_setting.py:845
msgid "Introductory text"
msgstr "Text introductori"

#: eventyay/base/configurations/default_setting.py:846
msgid "Will be printed on every invoice above the invoice rows."
msgstr "S'imprimirà a cada factura per damunt de les fileres de la factura."

#: eventyay/base/configurations/default_setting.py:860
msgid ""
"e.g. Thank you for your purchase! You can find more information on the event "
"at ..."
msgstr ""
"per exemple: Gràcies per la vostra compra! Podeu trobar més informació de "
"l'esdeveniment a..."

#: eventyay/base/configurations/default_setting.py:864
msgid "Additional text"
msgstr "Text addicional"

#: eventyay/base/configurations/default_setting.py:865
msgid "Will be printed on every invoice below the invoice total."
msgstr "S'imprimirà a cada factura sota el total."

#: eventyay/base/configurations/default_setting.py:879
msgid ""
"e.g. your bank details, legal details like your VAT ID, registration "
"numbers, etc."
msgstr ""
"per exemple els detalls del vostre banc, detalls legals com el vostre "
"identificador d'IVA, números de registre, etc."

#: eventyay/base/configurations/default_setting.py:883
msgid "Footer"
msgstr "Peu"

#: eventyay/base/configurations/default_setting.py:884
msgid ""
"Will be printed centered and in a smaller font at the end of every invoice "
"page."
msgstr ""
"S'imprimirà centrat i en una tipografia menor al final de cada pàgina de la "
"factura."

#: eventyay/base/configurations/default_setting.py:894
msgid "Attach invoices to emails"
msgstr "Adjunta les factures als correus"

#: eventyay/base/configurations/default_setting.py:896
msgid ""
"If invoices are automatically generated for all orders, they will be "
"attached to the order confirmation mail. If they are automatically generated "
"on payment, they will be attached to the payment confirmation mail. If they "
"are not automatically generated, they will not be attached to emails."
msgstr ""
"Si es generen les factures automàticament per a totes les comandes, "
"s'adjuntaran al correu de confirmació. Si es generen automàticament durant "
"el pagament, s'adjuntaran al correu de confirmació de pagament. Si no es "
"generen automàticament no s'adjuntaran als correus."

#: eventyay/base/configurations/default_setting.py:909
msgid "Show products outside presale period"
msgstr "Mostra els productes fora del període de prevenda"

#: eventyay/base/configurations/default_setting.py:910
msgid ""
"Show product details before presale has started and after presale has ended"
msgstr ""
"Mostra els detalls del producte abans que comenci la prevenda i després que "
"acabi"

#: eventyay/base/configurations/default_setting.py:927
#: eventyay/control/forms/event.py:102
#: eventyay/eventyay_common/forms/event.py:340
#, fuzzy
#| msgid "Event Language"
msgid "Event languages"
msgstr "Llengua de l'esdeveniment"

#: eventyay/base/configurations/default_setting.py:929
#: eventyay/eventyay_common/forms/event.py:343
msgid ""
"Users will be able to use eventyay in these languages, and you will be able "
"to provide all texts in these languages. If you don't provide a text in the "
"language a user selects, it will be shown in your event's default language "
"instead."
msgstr ""
"Els usuaris podran utilitzar eventyay en aquests idiomes, i tu podràs "
"proporcionar tots els textos en aquests idiomes. Si no proporciones un text "
"en l'idioma que un usuari selecciona, es mostrarà en l'idioma predeterminat "
"del teu esdeveniment."

#: eventyay/base/configurations/default_setting.py:948
msgid "Content languages"
msgstr "Llengües de contingut"

#: eventyay/base/configurations/default_setting.py:949
msgid "Users will be able to submit proposals in these languages."
msgstr "Els usuaris podran enviar propostes en aquestes llengües."

#: eventyay/base/configurations/default_setting.py:965
#: eventyay/base/models/event.py:689 eventyay/control/forms/event.py:187
msgid "Default language"
msgstr "Idioma predeterminat"

#: eventyay/base/configurations/default_setting.py:975
msgid "Region"
msgstr "Regió"

#: eventyay/base/configurations/default_setting.py:977
msgid ""
"Will be used to determine date and time formatting as well as default "
"country for attendee addresses and phone numbers. For formatting, this takes "
"less priority than the language and is therefore mostly relevant for "
"languages used in different regions globally (like English)."
msgstr ""
"S’utilitzarà per determinar el format de data i hora, així com el país "
"predeterminat per a les adreces i els números de telèfon dels assistents. "
"Pel que fa al format, té menys prioritat que l’idioma i, per tant, és "
"sobretot rellevant per a idiomes que s’utilitzen en diferents regions del "
"món (com l’anglès)."

#: eventyay/base/configurations/default_setting.py:990
msgid "Show event end date"
msgstr "Mostra la data de finalització de l'esdeveniment"

#: eventyay/base/configurations/default_setting.py:991
msgid "If disabled, only event's start date will be displayed to the public."
msgstr ""
"Si està desactivat només es mostrarà al públic la data d'inici de "
"l'esdeveniment."

#: eventyay/base/configurations/default_setting.py:1000
msgid "Show dates with time"
msgstr "Mostra la dates amb l'hora"

#: eventyay/base/configurations/default_setting.py:1001
msgid ""
"If disabled, the event's start and end date will be displayed without the "
"time of day."
msgstr ""
"Si està desactivat, la data d'inici i finalització de l'esdeveniment es "
"mostraran sense l'hora."

#: eventyay/base/configurations/default_setting.py:1010
msgid "Hide all products that are sold out"
msgstr "Amaga tots els productes que estiguin exhaurits"

#: eventyay/base/configurations/default_setting.py:1019
#: eventyay/base/models/product.py:429 eventyay/control/forms/event.py:1718
msgid "Show number of tickets left"
msgstr "Mostra el número restant de tiquets"

#: eventyay/base/configurations/default_setting.py:1020
#: eventyay/control/forms/event.py:1719
msgid "Publicly show how many tickets of a certain type are still available."
msgstr "Mostra públicament quants tiquets queden d'un tipus determinat."

#: eventyay/base/configurations/default_setting.py:1029
msgid "Ask search engines not to index the ticket shop"
msgstr "Demana als motors de cerque que no indexin la tenda de tiquets"

#: eventyay/base/configurations/default_setting.py:1038
msgid "Show variations of a product expanded by default"
msgstr "Mostra de manera predeterminada les variacions del producte expandides"

#: eventyay/base/configurations/default_setting.py:1047
msgid "Enable waiting list"
msgstr "Activa la llista d'espera"

#: eventyay/base/configurations/default_setting.py:1049
#: eventyay/control/forms/event.py:1725
msgid ""
"Once a ticket is sold out, people can add themselves to a waiting list. As "
"soon as a ticket becomes available again, it will be reserved for the first "
"person on the waiting list and this person will receive an email "
"notification with a voucher that can be used to buy a ticket."
msgstr ""
"Quan s'han exhaurit els tiquets la gent se pot afegir a una llista d'espera. "
"En el moment que torna a estar disponible un tiquet es reserva per la "
"primera persona de la llista d'espera i aquesta persona rep una notificació "
"de correu amb un val que se pot usar per comprar el tiquet."

#: eventyay/base/configurations/default_setting.py:1061
msgid "Automatic waiting list assignments"
msgstr "Assignació automàtica de la llista d'espera"

#: eventyay/base/configurations/default_setting.py:1063
msgid ""
"If ticket capacity becomes free, automatically create a voucher and send it "
"to the first person on the waiting list for that product. If this is not "
"active, mails will not be send automatically but you can send them manually "
"via the control panel. If you disable the waiting list but keep this option "
"enabled, tickets will still be sent out."
msgstr ""
"Si s'allibera la capacitat dels tiquets, automàticament genera un val i "
"envia'l a la primera persona de la llista d'espera per aquell producte. Si "
"això no està actiu, els correus no s'enviaran automàticament però podeu "
"enviar-los manualment via el panell de control. Si desactiveu la llista "
"d'espera però manteniu aquesta opció activada, s'enviaran igualment els "
"tiquets."

#: eventyay/base/configurations/default_setting.py:1077
msgid "Waiting list response time"
msgstr "Temps de resposta de la llista d'espera"

#: eventyay/base/configurations/default_setting.py:1080
msgid ""
"If a ticket voucher is sent to a person on the waiting list, it has to be "
"redeemed within this number of hours until it expires and can be re-assigned "
"to the next person on the list."
msgstr ""
"Si un val de tiquet s'envia a una persona de la llista d'espera s'ha de "
"validar durant aquest número d'hores fins que expira i es pot reassignar a "
"la següent persona de la llista."

#: eventyay/base/configurations/default_setting.py:1092
msgid "Ask for a name"
msgstr "Demana un nom"

#: eventyay/base/configurations/default_setting.py:1093
msgid "Ask for a name when signing up to the waiting list."
msgstr "Demana un nom en inscriure's a la llista d'espera."

#: eventyay/base/configurations/default_setting.py:1102
msgid "Require name"
msgstr "Requereix nom"

#: eventyay/base/configurations/default_setting.py:1103
msgid "Require a name when signing up to the waiting list.."
msgstr "Requereix un nom en registrar-se a la llista d'espera.."

#: eventyay/base/configurations/default_setting.py:1113
msgid "Ask for a phone number"
msgstr "Demana un número de telèfon"

#: eventyay/base/configurations/default_setting.py:1114
msgid "Ask for a phone number when signing up to the waiting list."
msgstr "Demana un número de telèfon en registrar-se a la llista d'espera."

#: eventyay/base/configurations/default_setting.py:1123
msgid "Require phone number"
msgstr "Requereix número de telèfon"

#: eventyay/base/configurations/default_setting.py:1124
msgid "Require a phone number when signing up to the waiting list.."
msgstr "Requereix un número de telèfon en registrar-se a la llista d'espera.."

#: eventyay/base/configurations/default_setting.py:1134
msgid "Phone number explanation"
msgstr "Explicació del número de telèfon"

#: eventyay/base/configurations/default_setting.py:1138
msgid ""
"If you ask for a phone number, explain why you do so and what you will use "
"the phone number for."
msgstr ""
"Si demanes un número de telèfon, explica per què ho fas i per a què "
"utilitzaràs el número de telèfon."

#: eventyay/base/configurations/default_setting.py:1148
msgid "Allow users to download tickets"
msgstr "Permet als usuaris descarregar entrades"

#: eventyay/base/configurations/default_setting.py:1149
msgid "If this is off, nobody can download a ticket."
msgstr "Si això està desactivat, ningú no podrà descarregar una entrada."

#: eventyay/base/configurations/default_setting.py:1164
msgid "Download date"
msgstr "Data de descàrrega"

#: eventyay/base/configurations/default_setting.py:1166
msgid ""
"Ticket download will be offered after this date. If you use the event series "
"feature and an order contains tickets for multiple event dates, download of "
"all tickets will be available if at least one of the event dates allows it."
msgstr ""
"La descàrrega de tiquets s'oferirà després d'aquesta data. Si utilitzeu la "
"funció d'esdeveniments en sèrie i una comanda conté tiquets per a múltiples "
"dates d'esdeveniments, la descàrrega de tots els tiquets estaran disponibles "
"si ho permet al menys una de les dates de l'esdeveniment."

#: eventyay/base/configurations/default_setting.py:1178
msgid "Generate tickets for add-on products"
msgstr "Genera entrades per a productes complementaris"

#: eventyay/base/configurations/default_setting.py:1180
msgid ""
"By default, tickets are only issued for products selected individually, not "
"for add-on products. With this option, a separate ticket is issued for every "
"add-on product as well."
msgstr ""
"Per defecte, les entrades només s'emeten per als productes seleccionats "
"individualment, no per als productes addicionals. Amb aquesta opció, també "
"s'emet una entrada separada per a cada producte addicional."

#: eventyay/base/configurations/default_setting.py:1197
msgid "Generate tickets for all products"
msgstr "Genera tiquets per a tots els productes"

#: eventyay/base/configurations/default_setting.py:1199
msgid ""
"If turned off, tickets are only issued for products that are marked as an "
"\"admission ticket\"in the product settings. You can also turn off ticket "
"issuing in every product separately."
msgstr ""
"Si està desactivat, les entrades només s'emeten per als productes que estan "
"marcats com a \"entrada d'accés\" a la configuració del producte. També pots "
"desactivar l'emissió d'entrades en cada producte per separat."

#: eventyay/base/configurations/default_setting.py:1216
msgid "Generate tickets for pending orders"
msgstr "Genera entrades per a comandes pendents"

#: eventyay/base/configurations/default_setting.py:1217
msgid ""
"If turned off, ticket downloads are only possible after an order has been "
"marked as paid."
msgstr ""
"Si està desactivat, les descàrregues d'entrades només són possibles després "
"que una comanda s'hagi marcat com a pagada."

#: eventyay/base/configurations/default_setting.py:1232
msgid "Do not issue ticket before email address is validated"
msgstr "No emetis l'entrada abans que l'adreça electrònica estigui validada"

#: eventyay/base/configurations/default_setting.py:1234
msgid ""
"If turned on, tickets will not be offered for download directly after "
"purchase. They will be attached to the payment confirmation email (if the "
"file size is not too large), and the attendee will be able to download them "
"from the page as soon as they clicked a link in the email. Does not affect "
"orders performed through other sales channels."
msgstr ""
"Si està activat, les entrades no s'oferiran per descarregar directament "
"després de la compra. S'adjuntaran al correu electrònic de confirmació de "
"pagament (si la mida del fitxer no és massa gran), i l'assistent podrà "
"descarregar-les des de la pàgina tan bon punt hagi fet clic en un enllaç del "
"correu electrònic. No afecta les comandes realitzades a través d'altres "
"canals de venda."

#: eventyay/base/configurations/default_setting.py:1247
msgid "Require user to be logged in to place an order"
msgstr "Requereix que l'usuari iniciï sessió per fer una comanda"

#: eventyay/base/configurations/default_setting.py:1249
#: eventyay/control/forms/event.py:73
msgid ""
"If this option is turned on, users must be logged in before completing an "
"order. When a user clicks \"Checkout\" without being logged in, they will be "
"redirected to the login page. The \"Continue as a Guest\" option will not be "
"available for attendees in this event."
msgstr ""
"Si aquesta opció està activada, els usuaris han d'iniciar sessió abans de "
"completar una comanda. Quan un usuari fa clic a «Checkout» sense haver "
"iniciat sessió, se'l redirigirà a la pàgina d'inici de sessió. L'opció «"
"Continue as a Guest» no estarà disponible per als assistents d'aquest "
"esdeveniment."

#: eventyay/base/configurations/default_setting.py:1261
msgid "Show availability in event overviews"
msgstr "Mostra la disponibilitat als resums d'esdeveniments"

#: eventyay/base/configurations/default_setting.py:1263
msgid ""
"If checked, the list of events will show if events are sold out. This might "
"make for longer page loading times if you have lots of events and the shown "
"status might be out of date for up to two minutes."
msgstr ""
"Si està marcat, la llista d'esdeveniments mostrarà si els esdeveniments "
"estan exhaurits. Això pot fer que els temps de càrrega de la pàgina siguin "
"més llargs si tens molts esdeveniments i l'estat mostrat podria estar "
"desactualitzat fins a dos minuts."

#: eventyay/base/configurations/default_setting.py:1277
#: eventyay/base/configurations/default_setting.py:1285
#: eventyay/orga/forms/event.py:33
#: eventyay/presale/templates/pretixpresale/organizers/base.html:124
msgid "List"
msgstr "Llista"

#: eventyay/base/configurations/default_setting.py:1278
#: eventyay/base/configurations/default_setting.py:1286
msgid "Week calendar"
msgstr "Calendari setmanal"

#: eventyay/base/configurations/default_setting.py:1279
#: eventyay/base/configurations/default_setting.py:1287
msgid "Month calendar"
msgstr "Calendari mensual"

#: eventyay/base/configurations/default_setting.py:1283
msgid "Default overview style"
msgstr "Estil de resum per defecte"

#: eventyay/base/configurations/default_setting.py:1290
msgid ""
"If your event series has more than 50 dates in the future, only the month or "
"week calendar can be used."
msgstr ""
"Si la teva sèrie d'esdeveniments té més de 50 dates en el futur, només es "
"podrà utilitzar el calendari mensual o setmanal."

#: eventyay/base/configurations/default_setting.py:1301
msgid "Hide all unavailable dates from calendar or list views"
msgstr ""
"Amaga totes les dates no disponibles de les vistes de calendari o llista"

#: eventyay/base/configurations/default_setting.py:1311
#: eventyay/base/configurations/default_setting.py:1320
msgid "No modifications after order was submitted"
msgstr "No es permeten modificacions després d'enviar la comanda"

#: eventyay/base/configurations/default_setting.py:1312
#: eventyay/base/configurations/default_setting.py:1321
msgid "Only the person who ordered can make changes"
msgstr "Només la persona que ha fet la comanda pot fer canvis"

#: eventyay/base/configurations/default_setting.py:1313
#: eventyay/base/configurations/default_setting.py:1322
msgid "Both the attendee and the person who ordered can make changes"
msgstr "Tant l'assistent com la persona que ha fet la comanda poden fer canvis"

#: eventyay/base/configurations/default_setting.py:1317
msgid "Allow customers to modify their information"
msgstr "Permet als clients modificar la seva informació"

#: eventyay/base/configurations/default_setting.py:1332
msgid "Allow attendees to modify their information after they checked in."
msgstr ""
"Permet als assistents modificar la seva informació després que hagin fet el "
"registre d'entrada."

#: eventyay/base/configurations/default_setting.py:1334
msgid ""
"By default, no more modifications are possible for an order as soon as one "
"of the tickets in the order has been checked in."
msgstr ""
"Per defecte, no es poden fer més modificacions a una comanda tan aviat com "
"una de les entrades de la comanda ha estat registrada."

#: eventyay/base/configurations/default_setting.py:1345
msgid "Last date of modifications"
msgstr "Darrera data de les modificacions"

#: eventyay/base/configurations/default_setting.py:1347
msgid ""
"The last date users can modify details of their orders, such as attendee "
"names or answers to questions. If you use the event series feature and an "
"order contains tickets for multiple event dates, the earliest date will be "
"used."
msgstr ""
"La darrera data que els usuaris poden modificar els detalls de les seves "
"comandes tals com els noms dels assistents o respondre a les preguntes. Si "
"useu la funció de sèries d'esdeveniments i la comanda conté tiquets per  "
"múltiples dates, s'utilitzarà la data més propera."

#: eventyay/base/configurations/default_setting.py:1362
#: eventyay/base/configurations/default_setting.py:1383
msgid ""
"Only allow changes if the resulting price is higher or equal than the "
"previous price."
msgstr ""
"Permet canvis només si el preu resultant és superior o igual al preu "
"anterior."

#: eventyay/base/configurations/default_setting.py:1366
#: eventyay/base/configurations/default_setting.py:1387
msgid ""
"Only allow changes if the resulting price is higher than the previous price."
msgstr "Permet canvis només si el preu resultant és superior al preu anterior."

#: eventyay/base/configurations/default_setting.py:1370
#: eventyay/base/configurations/default_setting.py:1391
msgid ""
"Only allow changes if the resulting price is equal to the previous price."
msgstr "Permet canvis només si el preu resultant és igual al preu anterior."

#: eventyay/base/configurations/default_setting.py:1374
#: eventyay/base/configurations/default_setting.py:1395
msgid "Allow changes regardless of price, even if this results in a refund."
msgstr ""
"Permet els canvis independentment del preu, fins i tot si això resulta en un "
"reemborsament."

#: eventyay/base/configurations/default_setting.py:1379
msgid "Requirement for changed prices"
msgstr "Requisit per als preus canviats"

#: eventyay/base/configurations/default_setting.py:1407
msgid "Do not allow changes after"
msgstr "No permetis canvis després de"

#: eventyay/base/configurations/default_setting.py:1416
msgid "Customers can cancel their unpaid orders"
msgstr "Els clients poden cancel·lar les seves comandes no pagades"

#: eventyay/base/configurations/default_setting.py:1425
#: eventyay/base/configurations/default_setting.py:1565
msgid "Do not allow cancellations after"
msgstr "No permetis cancel·lacions després de"

#: eventyay/base/configurations/default_setting.py:1434
msgid "Customers can cancel their paid orders"
msgstr "Els clients poden cancel·lar les seves comandes pagades"

#: eventyay/base/configurations/default_setting.py:1436
msgid ""
"Paid money will be automatically paid back if the payment method allows it. "
"Otherwise, a manual refund will be created for you to process manually."
msgstr ""
"Els diners abonats es reemborsaran automàticament si el mètode de pagament "
"ho permet. D'altra manera, es crearà una devolució manual perquè la "
"processeu manualment."

#: eventyay/base/configurations/default_setting.py:1448
#: eventyay/control/forms/orders.py:669
msgid "Keep a fixed cancellation fee"
msgstr "Manté una tarifa fixa de cancel·lació"

#: eventyay/base/configurations/default_setting.py:1457
msgid "Keep payment, shipping and service fees"
msgstr "Manté les tarifes de pagament, enviament i servei"

#: eventyay/base/configurations/default_setting.py:1467
#: eventyay/control/forms/orders.py:682
msgid "Keep a percentual cancellation fee"
msgstr "Manté una tarifa de cancel·lació percentual"

#: eventyay/base/configurations/default_setting.py:1477
msgid "Allow attendees to voluntarily choose a lower refund"
msgstr "Permet als assistents triar voluntàriament un reemborsament més baix"

#: eventyay/base/configurations/default_setting.py:1478
msgid ""
"With this option enabled, your attendees can choose to get a smaller refund "
"to support you."
msgstr ""
"Amb aquesta opció activada, els teus assistents poden optar per rebre un "
"reemborsament més petit per donar-te suport."

#: eventyay/base/configurations/default_setting.py:1484
msgid ""
"However, if you want us to help keep the lights on here, please consider "
"using the slider below to request a smaller refund. Thank you!"
msgstr ""
"Tanmateix, si vols que t’ajudem a mantenir els llums encesos, considera fer "
"servir el control lliscant de sota per sol·licitar un reemborsament més "
"petit. Gràcies!"

#: eventyay/base/configurations/default_setting.py:1492
msgid "Voluntary lower refund explanation"
msgstr "Explicació del reemborsament voluntàriament inferior"

#: eventyay/base/configurations/default_setting.py:1496
msgid ""
"This text will be shown in between the explanation of how the refunds work "
"and the slider which your attendees can use to choose the amount they would "
"like to receive. You can use it e.g. to explain choosing a lower refund will "
"help your organization."
msgstr ""
"Aquest text es mostrarà entre l’explicació de com funcionen els "
"reemborsaments i el control lliscant que els teus assistents poden utilitzar "
