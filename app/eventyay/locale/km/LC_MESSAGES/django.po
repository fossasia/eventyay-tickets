#: eventyay/presale/templates/pretixpresale/event/checkout_payment.html:78
#: eventyay/presale/templates/pretixpresale/event/checkout_questions.html:213
#: eventyay/presale/templates/pretixpresale/event/order_pay.html:27
#: eventyay/presale/templates/pretixpresale/event/order_pay_change.html:60
msgid "Continue"
msgstr "បន្ត"

#: eventyay/cfp/templates/cfp/event/submission_base.html:71
msgid "Submit proposal!"
msgstr "ដាក់សំណើសំនើរ!"

#: eventyay/cfp/templates/cfp/event/submission_base.html:75
msgid "or save as draft for now"
msgstr "ឬ រក្សាទុកជសំរាងសិន"

#: eventyay/cfp/templates/cfp/event/submission_base.html:76
msgid ""
"You can save your proposal as a draft and submit it later. Organisers will "
"not be able to see your proposal, though they will be able to send you "
"reminder emails about the upcoming deadline."
msgstr ""
"អាចរក្សាទុកសំណើររបស់ខ្លួនជាជសំរាង ហើយដាក់សំណើនៅពេលក្រោយបាន។ អ្នករៀបចំមិនអាចមើលឃើញសំណើរបស់ខ្លួន"
"បានទេ ប៉ុន្តែពួកគេអាចផ្សាយអ្នកដោយអ៊ីមែលរំលឹកអំពីការខិតជិតផុតកំណត់។"

#: eventyay/cfp/templates/cfp/event/submission_base.html:93
msgid "You need to be logged in to submit a proposal"
msgstr "ត្រូវចូលគណនីដើម្បីដាក់សំណើសំនើ"

#: eventyay/cfp/templates/cfp/event/submission_base.html:94
msgid ""
"Please log in or create an account to submit a proposal. This enables us to "
"contact you and allows you to edit your proposal or check its status at any "
"time."
msgstr ""
"សូមចូលគណនី ឬបង្កើតគណនីដើម្បីដាក់សំណើសំនើ។ វានេះអនុញ្ញាតឱ្យអ្នករៀបចំអាចទំនាក់ទំនងអ្នក ហើយអនុញ្ញាតឱ្យ"
"អ្នកកែសម្រួលសំណើរបស់ខ្លួន ឬពិនិត្យមើលស្ថានភាពរបស់វាគ្រប់ពេល។"

#: eventyay/cfp/templates/cfp/event/submission_questions.html:13
msgid "… about your proposal:"
msgstr "… អំពីសំណើរបស់ខ្លួន៖"

#: eventyay/cfp/templates/cfp/event/submission_questions.html:21
msgid "… about yourself:"
msgstr "… អំពីខ្លួនឯង៖"

#: eventyay/cfp/templates/cfp/event/submission_user.html:9
msgid "Sign in or register to save your draft"
msgstr "ចូលគណនី ឬចុះឈ្មោះដើម្បីរក្សាទុកជសំរាង"

#: eventyay/cfp/templates/cfp/event/submission_user.html:18
msgid ""
"Organisers will not be able to see your draft or your email address. They "
"will be able to send you reminders about your pending proposal draft closer "
"to the deadline."
msgstr ""
"អ្នករៀបចំមិនអាចមើលឃើញជសំរាង ឬអាដ្រេសអ៊ីមែលរបស់ខ្លួនបានទេ។ ពួកគេអាចផ្សាយអ្នកដោយអ៊ីមែលរំលឹកអំពីជសំ"
"រាងសំណើរដែលមិនទាន់ដាក់សំណើ ជិតថ្ងៃកំណត់។"

#: eventyay/cfp/templates/cfp/event/user_mails.html:4
#: eventyay/cfp/templates/cfp/event/user_mails.html:7
msgid "Your Emails"
msgstr "អ៊ីមែលរបស់ខ្លួន"

#: eventyay/cfp/templates/cfp/event/user_mails.html:9
msgid ""
"These are emails the organisers sent you, so you should be able to find them "
"in your email inbox, but this page serves as a helper in case your email "
"address was unavailable or the emails got lost in some way."
msgstr ""
"នេះជាអ៊ីមែលដែលអ្នករៀបចំផ្សាយអ្នក។ ពីប្រោះដូច្នេះ គួរអាចស្វែងរកបាននៅក្នុងប្រអប់សំណុំសារអ៊ីមែលរបស់ខ្លួ"
"ន ប៉ុន្តែទំព័រនេះមានតួនាទីជាជំនួយ ក្នុងករណីអាដ្រេសអ៊ីមែលមិនអាចប្រើងានបាន ឬអ៊ីមែលត្រូវបានបាត់បង់ដោយរូប"
"រាបាណាមួយ។"

#: eventyay/cfp/templates/cfp/event/user_profile.html:5
#: eventyay/cfp/templates/cfp/event/user_profile.html:14
msgid "Your Profile"
msgstr "ប្រវត្តិរូបរបស់ខ្លួន"

#: eventyay/cfp/templates/cfp/event/user_profile.html:16
msgid ""
"This data will be displayed publicly if your proposal is accepted. It is "
"also visible to reviewers."
msgstr ""
"ទិន្នន័យនេះនឹងបង្ហាញជាសាធារណៈ បើសំណើរបស់ខ្លួនត្រូវបានទទួលយក។ វាក៏អាចមើលឃើញដោយអ្នកវាយតម្លៃដែរ"
"។"

#: eventyay/cfp/templates/cfp/event/user_profile.html:37
msgid "We have some questions"
msgstr "មានសំណួរមួយចំនួន"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm.html:20
msgid "Congratulations on your acceptance!"
msgstr "អនុម័ទនាដែលបានទទួលយក។"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm.html:24
msgid ""
"Please provide us with your available hours during the event, so that we can "
"schedule your event accordingly:"
msgstr ""
"សូមផ្តល់ម៉ោងដែលអាចចូលរួមបានក្នុងអំឡុងពេលព្រឹត្តិការណ៍ ដើម្បីអាចរៀបចំកាលវិភាគសម្រាប់ព្រឹត្តិការណ៍បានត្រឹមត្"
"រូវ៖"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm.html:40
msgid ""
"By confirming your proposal, you agree that you are able and willing to "
"participate in this event and present the content of this proposal. The "
"proposal data, such as title, abstract, description, and any uploads you "
"provided, can be made publicly available once the proposal is confirmed."
msgstr ""
"តាមរយៈការបញ្ជាក់សំណើរបស់អ្នក អ្នកយល់ព្រមថា អ្នកអាច និងមានឆន្ទៈចូលរួមក្នុងព្រឹត្តិការណ៍នេះ និងបង្ហាញ"
"មាតិកានៃសំណើនេះ។ ទិន្នន័យសំណើ ដូចជា ចំណងជើង សេចក្តីសង្ខេប សេចក្តីពិពណ៌នា និងឯកសារដែលបានផ្ទុកឡើង"
"ណាមួយ អាចត្រូវបានបង្ហាញជាសាធារណៈ បន្ទាប់ពីសំណើត្រូវបានបញ្ជាក់។"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm.html:50
#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:143
#: eventyay/cfp/templates/cfp/event/user_submission_withdraw.html:23
msgid "Withdraw"
msgstr "ដកចេញ"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm.html:53
#: eventyay/cfp/templates/cfp/event/user_submissions.html:142
#: eventyay/control/templates/pretixcontrol/admin/users/index.html:324
msgid "Confirm"
msgstr "បញ្ជាក់"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm_error.html:7
#: eventyay/cfp/templates/cfp/event/user_submission_confirm_error.html:11
msgid "Proposal not found"
msgstr "រកមិនឃើញសំណើ"

#: eventyay/cfp/templates/cfp/event/user_submission_confirm_error.html:13
msgid ""
"The proposal you’re trying to confirm either does not exist or does not "
"belong to the account you’re currently logged in with. Try logging in with a "
"different account, or contact the event organisers for further information."
msgstr ""
"សំណើដែលកំពុងព្យាយាមបញ្ជាក់ អាចមិនមាន ឬមិនមែនជាសំណើដែលស្ថិតក្រោមគណនីដែលបានចូលប្រើបច្ចុប្បន្ន។ សាក"
"ល្បងចូលប្រើដោយប្រើគណនីផ្សេង ឬទាក់ទងអ្នករៀបចំព្រឹត្តិការណ៍សម្រាប់ព័ត៌មានបន្ថែម។"

#: eventyay/cfp/templates/cfp/event/user_submission_discard.html:16
msgid ""
"Do you really want to discard your draft proposal? All data will be lost."
msgstr "តើពិតជាចង់បោះបង់សេចក្តីព្រាងសំណើឬ? ទិន្នន័យទាំងអស់នឹងបាត់បង់។"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:34
msgid ""
"This proposal has been withdrawn. The details below are shown for your "
"reference and cannot be edited."
msgstr ""

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:36
msgid ""
"This proposal has been rejected. The details below are shown for your "
"reference and cannot be edited."
msgstr ""

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:38
msgid ""
"This proposal has been canceled. The details below are shown for your "
"reference and cannot be edited."
msgstr ""

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:40
#, fuzzy
#| msgid "This proposal cannot be edited anymore."
msgid "This proposal cannot be edited at this time."
msgstr "មិនអាចកែសម្រួលសំណើនេះបានទៀតទេ។"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:48
msgid "Confirm your attendance"
msgstr "បញ្ជាក់ការចូលរួម"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:53
msgid "Audience feedback"
msgstr "មតិយោបល់ទស្សនិកជន"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:55
msgid "Attendees can leave feedback here after your session has taken place."
msgstr ""
"អ្នកចូលរួមអាចទុកមតិយោបល់នៅទីនេះ បន្ទាប់ពីវគ្គរបស់អ្នកបានប្រព្រឹត្តទៅរួច។"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:62
msgid "Speaker"
msgid_plural "Speakers"
msgstr[0] "វាគ្មិន"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:64
msgid "Submitter"
msgid_plural "Submitters"
msgstr[0] "អ្នកដាក់ស្នើ"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:103
msgid "Save draft"
msgstr "រក្សាទុកសេចក្តីព្រាង"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:106
msgid "Submit proposal"
msgstr "ដាក់ស្នើសំណើ"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:122
msgid "Share proposal"
msgstr "ចែករំលែកសំណើ"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:124
msgid ""
"If you need a review from a colleague or a friend here’s a link that you can "
"send out for viewing your proposal:"
msgstr ""
"ប្រសិនបើត្រូវការឲ្យមិត្តរួមការងារ ឬមិត្តភក្តិពិនិត្យ នេះជាតំណភ្ជាប់ដែលអាចផ្ញើឲ្យមើលសំណើបាន៖"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:132
#: eventyay/cfp/templates/cfp/event/user_submission_withdraw.html:14
msgid "Withdraw proposal"
msgstr "ដកសំណើចេញ"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:134
msgid ""
"You can withdraw your proposal from the selection process here. You cannot "
"undo this - if you are just uncertain if you can or should hold your "
"session, please contact the organiser instead."
msgstr ""
"អាចដកសំណើចេញពីដំណើរការជ្រើសរើសនៅទីនេះ។ មិនអាចបោះបង់វិញបានទេ—ប្រសិនបើគ្រាន់តែមិនប្រាកដថាអាច "
"ឬគួរធ្វើវគ្គរបស់អ្នក សូមទាក់ទងអ្នករៀបចំជំនួសវិញ។"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:148
msgid "Discard draft proposal"
msgstr "បោះបង់សេចក្តីព្រាងសំណើ"

#: eventyay/cfp/templates/cfp/event/user_submission_edit.html:150
msgid ""
"You can discard your draft proposal here. You cannot undo this - if you are "
"just uncertain if you can or should submit your proposal, please contact the "
"organiser instead."
