msgstr "វ៉ោឆ័រដែលបានកំណត់"

#: eventyay/base/models/waitinglist.py:64
msgid "The product the user waits for."
msgstr "ផលិតផលដែលអ្នកប្រើកំពុងរង់ចាំ។"

#: eventyay/base/models/waitinglist.py:73
msgid "The variation of the product selected above."
msgstr "បម្រែបម្រួលនៃផលិតផលដែលបានជ្រើសខាងលើ។"

#: eventyay/base/models/waitinglist.py:81
msgid "Waiting list entry"
msgstr "ធាតុបញ្ជីរង់ចាំ"

#: eventyay/base/models/waitinglist.py:82
msgid "Waiting list entries"
msgstr "ធាតុបញ្ជីរង់ចាំ"

#: eventyay/base/models/waitinglist.py:121
msgid "This product is currently not available."
msgstr "ផលិតផលនេះមិនមានសម្រាប់ប្រើប្រាស់នៅពេលនេះទេ។"

#: eventyay/base/models/waitinglist.py:123
msgid "A voucher has already been sent to this person."
msgstr "វ៉ោឆ័រមួយត្រូវបានផ្ញើទៅមនុស្សនេះរួចហើយ។"

#: eventyay/base/models/waitinglist.py:125
msgid "This entry is anonymized and can no longer be used."
msgstr "ធាតុនេះត្រូវបានធ្វើអនាមិក ហើយមិនអាចប្រើបានទៀតទេ។"

#: eventyay/base/models/waitinglist.py:135
#, python-brace-format
msgid "Automatically created from waiting list entry for {email}"
msgstr "បានបង្កើតដោយស្វ័យប្រវត្តិពីធាតុបញ្ជីរង់ចាំសម្រាប់ {email}"

#: eventyay/base/models/waitinglist.py:162
#, python-brace-format
msgid "You have been selected from the waitinglist for {event}"
msgstr "ត្រូវបានជ្រើសពីបញ្ជីរង់ចាំសម្រាប់ {event}"

#: eventyay/base/models/waitinglist.py:172
msgid "The selected product does not belong to this event."
msgstr "ផលិតផលដែលបានជ្រើសមិនស្ថិតក្នុងព្រឹត្តិការណ៍នេះទេ។"

#: eventyay/base/models/waitinglist.py:174
