#: eventyay/plugins/reports/exporters.py:864
msgid "City"
msgstr "เมือง"

#: eventyay/base/configurations/default_setting.py:811
#: eventyay/base/exporters/invoices.py:191
#: eventyay/base/exporters/invoices.py:199
