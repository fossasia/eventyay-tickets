#: eventyay/cfp/phrases.py:7
msgid "Go to CfP"
msgstr "CfP ലേക്ക് പോകുക"

#: eventyay/cfp/phrases.py:10
msgid ""
"If we know a user by this email address (who has not requested a password "
"reset in the last 24 hours), we will send you an email containing further "
"instructions. If you don’t see the email within the next minutes, check your "
"spam inbox!"
msgstr ""
"ഈ ഇമെയിൽ വിലാസത്തോട് ബന്ധപ്പെട്ടൊരു ഉപയോക്താവിനെ അറിയുന്നുവെങ്കിൽ (കഴിഞ്ഞ 24 മണിക്കൂറിനുള്ളിൽ "
"പാസ്‌വേഡ് റീസെറ്റ് അഭ്യർത്ഥിച്ചിട്ടില്ലാത്ത), കൂടുതൽ നിർദ്ദേശങ്ങൾ അടങ്ങിയ ഒരു ഇമെയിൽ അയക്കും. "
"അടുത്ത കുറച്ച് മിനിറ്റുകൾക്കുള്ളിൽ ഇമെയിൽ കാണുന്നില്ലെങ്കിൽ സ്പാം ഇൻബോക്സ് പരിശോധിക്കുക!"

#: eventyay/cfp/phrases.py:14
msgid ""
"This link was not valid. Make sure you copied the complete URL from the "
"email and that the email is no more than 24 hours old."
msgstr ""
"ഈ ലിങ്ക് അസാധുവാണ്. ഇമെയിലിൽ നിന്ന് പൂർണ്ണ URL കോപ്പി ചെയ്തിട്ടുണ്ടെന്നും ഇമെയിൽ 24 "
"മണിക്കൂറിനകം ഉള്ളതാണെന്നും ഉറപ്പാക്കുക."

#: eventyay/cfp/phrases.py:17
msgid "Awesome! You can now log in using your new password."
msgstr "പുതിയ പാസ്‌വേഡ് ഉപയോഗിച്ച് ഇപ്പോൾ ലോഗിൻ ചെയ്യാം."

#: eventyay/cfp/phrases.py:19
msgid "Your proposal has been withdrawn."
msgstr "നിർദ്ദേശം പിൻവലിച്ചു."

#: eventyay/cfp/phrases.py:21
msgid ""
"Your proposal can’t be withdrawn at this time – please contact us if you "
"need to withdraw your proposal!"
msgstr ""
"ഈ സമയത്ത് നിർദ്ദേശം പിൻവലിക്കാൻ കഴിയില്ല — നിർദ്ദേശം പിൻവലിക്കേണ്ടതുണ്ടെങ്കിൽ ബന്ധപ്പെടുക!"

#: eventyay/cfp/phrases.py:23
msgid "Your session has been confirmed – we’re looking forward to seeing you!"
msgstr "സെഷൻ സ്ഥിരീകരിച്ചു — കാണാൻ ആകാംക്ഷയോടെ കാത്തിരിക്കുന്നു!"

#: eventyay/cfp/phrases.py:24
msgid ""
"This proposal has already been confirmed – we’re looking forward to seeing "
"you!"
msgstr "ഈ നിർദ്ദേശം ഇതിനകം സ്ഥിരീകരിച്ചു — കാണാൻ ആകാംക്ഷയോടെ കാത്തിരിക്കുന്നു!"

#: eventyay/cfp/phrases.py:26
msgid ""
"This proposal cannot be confirmed at this time – please contact us if you "
"think this is an error."
msgstr ""
"ഈ സമയത്ത് ഈ നിർദ്ദേശം സ്ഥിരീകരിക്കാനാകില്ല — ഇത് പിഴവാണെന്ന് തോന്നുന്നുവെങ്കിൽ ബന്ധപ്പെടുക."

#: eventyay/cfp/phrases.py:28
msgid "This proposal cannot be edited anymore."
msgstr "ഈ നിർദ്ദേശം ഇനി തിരുത്താനാകില്ല."

#: eventyay/cfp/phrases.py:30 eventyay/cfp/phrases.py:53
msgid "Speaker email"
msgstr "സ്പീക്കർ ഇമെയിൽ"

#: eventyay/cfp/phrases.py:31 eventyay/cfp/phrases.py:54
#, python-brace-format
msgid "{speaker} invites you to join their session!"
msgstr "{speaker} സെഷനിൽ ചേരാൻ ക്ഷണിക്കുന്നു!"

#: eventyay/cfp/phrases.py:33 eventyay/cfp/phrases.py:56
#, python-brace-format
msgid ""
"Hi!\n"
"\n"
"I’d like to invite you to be a speaker in the session\n"
"\n"
"  “{title}”\n"
"\n"
"at {event}. Please follow this link to join:\n"
"\n"
"  {url}\n"
"\n"
"I’m looking forward to it!\n"
"{speaker}"
msgstr ""
"ഹായ്!\n"
"\n"
"സെഷനിൽ ഒരു സ്പീക്കറായി നിങ്ങളെ ക്ഷണിക്കാൻ ആഗ്രഹിക്കുന്നു\n"
"\n"
"  “{title}”\n"
"\n"
"{event} ൽ. ചേരാൻ ഈ ലിങ്ക് പിന്തുടരുക:\n"
"\n"
"  {url}\n"
"\n"
"ആകാംക്ഷയോടെ കാത്തിരിക്കുന്നു!\n"
"{speaker}"

#: eventyay/cfp/phrases.py:46
msgid "Please provide a valid email address."
msgstr "സാധുവായ ഒരു ഇമെയിൽ വിലാസം നൽകുക."

#: eventyay/cfp/phrases.py:47
msgid "The invitation was sent!"
msgstr "ക്ഷണം അയച്ചു!"

#: eventyay/cfp/phrases.py:48
msgid "You are now part of this proposal! Please fill in your profile below."
msgstr "ഇപ്പോൾ ഈ നിർദ്ദേശത്തിന്റെ ഭാഗമാണ്! താഴെ പ്രൊഫൈൽ പൂരിപ്പിക്കുക."

#: eventyay/cfp/phrases.py:51
msgid ""
"We are experiencing difficulties when sending mails, but your session was "
"submitted successfully!"
msgstr ""
"മെയിലുകള്‍ അയക്കുന്നതില്‍ പ്രശ്നങ്ങളുണ്ട്, പക്ഷേ സെഷന്‍ വിജയകരമായി സമര്‍പ്പിച്ചു!"

#: eventyay/cfp/phrases.py:69 eventyay/orga/views/cfp.py:440
msgid "Custom fields"
msgstr "ഇഷ്ടാനുസൃത ഫീല്‍ഡുകള്‍"

#: eventyay/cfp/templates/cfp/event/cfp.html:31
#, python-format
msgid ""
"You can enter proposals until %(deadline)s (%(timezone)s), %(until_string)s "
"from now."
msgstr ""
"ഇപ്പോള്‍ മുതല്‍ %(until_string)s കഴിഞ്ഞ് %(deadline)s (%(timezone)s) വരെ പ്രപ്പോസലുകള്‍ "
"നല്‍കാം."

#: eventyay/cfp/templates/cfp/event/cfp.html:35
#, python-format
msgid "This Call for Papers closed on %(deadline)s (%(timezone)s)."
msgstr "ഈ കോള്ഫോര്‍ പേപ്പര്‍സ് %(deadline)s (%(timezone)s)-ന് അവസാനിച്ചു."

#: eventyay/cfp/templates/cfp/event/cfp.html:60
msgid "View or edit speaker profile"
msgstr "വക്താവിന്റെ പ്രൊഫൈല്‍ കാണുക അല്ലെങ്കില്‍ തിരുത്തുക"

#: eventyay/cfp/templates/cfp/event/cfp.html:67
msgid "Submit a proposal"
msgstr "ഒരു പ്രപ്പോസല്‍ സമര്‍പ്പിക്കുക"

#: eventyay/cfp/templates/cfp/event/cfp.html:69 eventyay/cfp/views/wizard.py:46
msgid "Proposals are closed"
msgstr "പ്രപ്പോസലുകള്‍ അടച്ചു"

#: eventyay/cfp/templates/cfp/event/index.html:35
msgid "Go To Organiser Area"
msgstr "ഓര്‍ഗനൈസര്‍ ഏരിയയിലേക്ക് പോകുക"

#: eventyay/cfp/templates/cfp/event/invitation.html:7
#: eventyay/cfp/templates/cfp/event/invitation.html:10
msgid "Accept invitation?"
msgstr "ആഹ്വാനം സ്വീകരിക്കണോ?"

#: eventyay/cfp/templates/cfp/event/invitation.html:14
msgid ""
"Unfortunately, you cannot accept this invitation at the moment. This may be "
"because the invitation has expired, or because the proposal cannot be edited "
"any more."
msgstr ""
"ക്ഷമിക്കണം, ഇപ്പോള്‍ ഈ ആഹ്വാനം സ്വീകരിക്കാന്‍ കഴിയില്ല. ആഹ്വാനത്തിന്റെ കാലാവധി കഴിഞ്ഞിരിക്കാം, "
"അല്ലെങ്കില്‍ പ്രപ്പോസല്‍ ഇനി തിരുത്താനാകില്ലായിരിക്കാം."

#: eventyay/cfp/templates/cfp/event/invitation.html:21
msgid "Please contact the conference organizers for more information."
msgstr "കൂടുതല്‍ വിവരങ്ങള്‍ക്കായി കോണ്‍ഫറന്‍സ് ഓര്‍ഗനൈസര്‍മാരെ ബന്ധപ്പെടുക."

#: eventyay/cfp/templates/cfp/event/invitation.html:27
#, python-format
msgid ""
"You, %(name)s, have been invited to be a speaker for the session “%(talk)s”. "
"Do you accept the invitation?"
msgstr ""
"നിങ്ങളെ, %(name)s, “‌%(talk)s” സെഷനിലെ വക്താവായി ക്ഷണിച്ചിട്ടുണ്ട്. ആഹ്വാനം സ്വീകരിക്കുമോ?"

#: eventyay/cfp/templates/cfp/event/invitation.html:35
msgid "Abstract:"
msgstr "അബ്സ്ട്രാക്റ്റ്:"

#: eventyay/cfp/templates/cfp/event/invitation.html:45
msgid "Accept invitation"
msgstr "ആഹ്വാനം സ്വീകരിക്കുക"

#: eventyay/cfp/templates/cfp/event/login.html:5
#: eventyay/common/templates/common/fragment_header_user.html:156
#: eventyay/common/templates/common/fragment_header_user.html:158
#: eventyay/common/text/phrases.py:121
