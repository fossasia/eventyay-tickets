#, python-brace-format
msgid "Your proposal: {submission_title}"
msgstr "Teklifiniz: {submission_title}"

#: eventyay/mail/default_templates.py:8
#, python-brace-format
msgid ""
"Hi!\n"
"\n"
"We have received your proposal “{submission_title}” to\n"
"{event_name}. We will notify you once we have had time to consider all\n"
"proposals, but until then you can see and edit your proposal at\n"
"{submission_url}.\n"
"\n"
"Please do not hesitate to contact us if you have any questions!\n"
"\n"
"The {event_name} organisers"
msgstr ""
"Merhaba!\n"
"\n"
"{event_name} için “{submission_title}” başlıklı teklifinizi aldık. Tüm "
"teklifleri değerlendirmek için biraz zamana ihtiyacımız var; değerlendirme "
"tamamlanınca sizi bilgilendireceğiz. O zamana kadar teklifinizi "
"{submission_url} adresinden görüntüleyip düzenleyebilirsiniz.\n"
"\n"
"Sorularınız olursa lütfen bizimle iletişime geçmekten çekinmeyin!\n"
"\n"
"{event_name} organizatörleri"

#: eventyay/mail/default_templates.py:23
#, python-brace-format
msgid ""
"Hi!\n"
"\n"
"We are happy to tell you that we accept your proposal \"{submission_title}"
"\"\n"
"to {event_name}. Please click this link to confirm your attendance:\n"
"\n"
"{confirmation_link}\n"
"\n"
"We look forward to seeing you at {event_name} - Please contact us if you "
"have any\n"
"questions! We will reach out again before the conference to tell you "
"details\n"
"about your slot in the schedule and technical details concerning the room\n"
"and presentation tech.\n"
"\n"
"See you there!\n"
"The {event_name} organisers"
msgstr ""
"Merhaba!\n"
"\n"
"{event_name} için \"{submission_title}\" başlıklı teklifinizi kabul "
"ettiğimizi memnuniyetle bildiririz. Katılımınızı onaylamak için lütfen bu "
"bağlantıya tıklayın:\n"
"\n"
"{confirmation_link}\n"
"\n"
"{event_name} etkinliğinde görüşmeyi dört gözle bekliyoruz - herhangi bir "
"sorunuz olursa lütfen bizimle iletişime geçin! Konferans öncesinde, "
"programdaki zaman diliminiz ve oda ile sunum tekniğine ilişkin teknik "
"ayrıntılar hakkında size tekrar bilgi vereceğiz.\n"
"\n"
"Görüşmek üzere!\n"
"{event_name} organizatörleri"

