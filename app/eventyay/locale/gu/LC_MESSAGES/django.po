#: eventyay/control/forms/orders.py:724 eventyay/control/forms/orders.py:768
#, python-brace-format
msgid "Canceled: {event}"
msgstr "રદ કરેલ: {event}"

#: eventyay/control/forms/orders.py:736
#, python-brace-format
msgid ""
"Hello,\n"
"\n"
"with this email, we regret to inform you that {event} has been canceled.\n"
"\n"
"We will refund you {refund_amount} to your original payment method.\n"
"\n"
"You can view the current state of your order here:\n"
"\n"
"{url}\n"
"\n"
"Best regards,\n"
"\n"
"Your {event} team"
msgstr ""
"નમસ્તે,\n"
"\n"
"આ ઇમેલ દ્વારા અફસોસ સાથે જાણ કરવામાં આવે છે કે {event} રદ કરવામાં આવ્યું છે.\n"
"\n"
"મૂળ ચુકવણી પદ્ધતિમાં {refund_amount} રીફંડ કરવામાં આવશે.\n"
"\n"
