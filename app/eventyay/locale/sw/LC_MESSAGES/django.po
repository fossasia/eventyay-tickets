"{submission_url}.\n"
"\n"
"Tafadhali usisite kuwasiliana nasi ikiwa una maswali yoyote!\n"
"\n"
"Waandaaji wa {event_name}"

#: eventyay/mail/default_templates.py:23
#, python-brace-format
msgid ""
"Hi!\n"
"\n"
"We are happy to tell you that we accept your proposal \"{submission_title}"
