msgstr ""
"کن تجاویزات کا اندراج %(deadline)s (%(timezone)s) تک کیا جا سکتا ہے، اب سے %"
"(until_string)s۔"

#: eventyay/cfp/templates/cfp/event/cfp.html:35
#, python-format
msgid "This Call for Papers closed on %(deadline)s (%(timezone)s)."
msgstr "ایہ کال فار پیپرز %(deadline)s (%(timezone)s) کو بند ہو گیا تھا۔"

#: eventyay/cfp/templates/cfp/event/cfp.html:60
