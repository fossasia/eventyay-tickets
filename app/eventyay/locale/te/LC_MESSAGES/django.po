msgstr "కొత్త బృందం"

#: eventyay/orga/templates/orga/review/assignment.html:42
msgid "Members"
msgstr "సభ్యులు"

#: eventyay/orga/templates/orga/review/assignment.html:44
msgid "Limited to tracks"
msgstr "ట్రాక్‌లకు మాత్రమే పరిమితం"

