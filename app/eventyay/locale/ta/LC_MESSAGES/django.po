#: eventyay/control/forms/orders.py:393 eventyay/control/forms/orders.py:423
#: eventyay/control/forms/orders.py:438 eventyay/control/forms/orders.py:462
msgid "(Unchanged)"
msgstr "(மாற்றமில்லை)"

#: eventyay/control/forms/orders.py:391 eventyay/control/forms/orders.py:460
msgid "New price (gross)"
msgstr "புதிய விலை (மொத்தம்)"

#: eventyay/control/forms/orders.py:394
msgid "Generate a new secret"
msgstr "புதிய ரகசியத்தை உருவாக்கவும்"

#: eventyay/control/forms/orders.py:395
msgid "Cancel this position"
msgstr "இந்த உருப்படியை ரத்து செய்யவும்"

#: eventyay/control/forms/orders.py:396
msgid "Split into new order"
msgstr "புதிய ஆர்டராக பிரிக்கவும்"

#: eventyay/control/forms/orders.py:463
msgid "Remove this fee"
msgstr "இந்த கட்டணத்தை நீக்கவும்"

#: eventyay/control/forms/orders.py:479
msgid "Invalidate secrets"
msgstr "ரகசியங்களை செல்லாததாக்கவும்"

#: eventyay/control/forms/orders.py:481
msgid ""
"Regenerates the order and ticket secrets. You will need to re-send the link "
"to the order page to the user and the user will need to download his tickets "
"again. The old versions will be invalid."
msgstr ""
"ஆர்டர் மற்றும் டிக்கெட் ரகசியங்களை மீண்டும் உருவாக்குகிறது. ஆர்டர் பக்கத்திற்கான இணைப்பை "
"பயனருக்கு மீண்டும் அனுப்ப வேண்டும்; மேலும் பயனர் தனது டிக்கெட்டுகளை மீண்டும் பதிவிறக்க "
"வேண்டும். பழைய பதிப்புகள் செல்லாது."

#: eventyay/control/forms/orders.py:515 eventyay/control/forms/orders.py:721
#: eventyay/control/forms/orders.py:766 eventyay/control/forms/vouchers.py:265
