#: eventyay/presale/templates/pretixpresale/event/checkout_questions.html:84
msgid "Seat"
msgstr "இருப்பு"

#: eventyay/control/forms/orders.py:279
msgid "Including taxes, if any. Keep empty for the product's default price"
msgstr "வரி இருந்தால் உட்பட. தயாரிப்பின் இயல்புநிலை விலைக்கு காலியாக விடவும்"

#: eventyay/control/forms/orders.py:302 eventyay/control/forms/orders.py:442
#: eventyay/control/forms/product.py:1066
msgid "inactive"
msgstr "செயலற்றது"

