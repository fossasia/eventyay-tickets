###########
# BUILDER #
###########

# pull official base image
FROM python:3.12-slim-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# set work directory
ENV APP_HOME=/home/app/web
RUN mkdir -p $APP_HOME
WORKDIR $APP_HOME

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# install system dependencies
# Repo for newer NodeJS
RUN apt-get update && apt-get install -y wget gnupg
RUN wget -qO- https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
RUN apt-get update && \
    apt-get install -y --no-install-recommends git build-essential gettext make nodejs

# Build mode: "production" (default) uses locked deps, "dev" refreshes plugins
ARG BUILD_MODE=production
# Cache buster for dev builds — pass a unique value (e.g. timestamp) to prevent
# Docker from reusing stale dependency layers when BUILD_MODE=dev
ARG CACHE_BUST=0

# install python dependencies
# Ref: https://docs.astral.sh/uv/guides/integration/docker/#non-editable-installs
#
# Production: use --locked to ensure reproducible builds from uv.lock.
# Dev/staging: copy full project context and use --upgrade-package to fetch
# the latest commit for each plugin from its configured branch.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$BUILD_MODE" = "dev" ]; then \
      echo "=== Dev build: refreshing plugins (CACHE_BUST=$CACHE_BUST) ===" && \
      uv sync --no-install-project --no-editable --refresh \
        --upgrade-package eventyay-paypal \
        --upgrade-package eventyay-stripe \
        --upgrade-package eventyay-bitpay \
        --upgrade-package eventyay-socialmedia \
        --upgrade-package exhibition \
        --upgrade-package eventyay-teamshifts \
        --upgrade-package eventyay-interpretation \
        --upgrade-package eventyay-hubspot \
        --upgrade-package eventyay-business; \
    else \
      echo "=== Production build: using locked dependencies ===" && \
      uv sync --locked --no-install-project --no-editable; \
    fi

# Log installed plugin versions for build traceability
RUN echo "=== Installed plugin versions ===" && \
    uv pip freeze 2>/dev/null \
      | grep -iE 'eventyay-paypal|eventyay-stripe|eventyay-bitpay|eventyay-socialmedia|exhibition|eventyay-teamshifts|eventyay-interpretation|eventyay-hubspot' \
    || echo "(no plugins found — check build output above)"

COPY Makefile Makefile


#########
# FINAL #
#########

# pull official base image
FROM python:3.12-slim-trixie

# create directory for the app user
RUN mkdir -p /home/app

# create the app user
RUN addgroup --system app && adduser --system --group app

# create the appropriate directories
ENV HOME=/home/app
ENV APP_HOME=/home/app/web
RUN mkdir $APP_HOME
RUN mkdir $APP_HOME/static
WORKDIR $APP_HOME

# install dependencies
RUN apt-get update && apt-get install -y wget gnupg rsync
RUN wget -qO- https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
RUN apt-get update && apt-get install -y --no-install-recommends netcat-traditional nodejs gettext less

# copy project
COPY . $APP_HOME

# fix line endings for entrypoint.prod.sh
RUN sed -i 's/\r$//g'  $APP_HOME/entrypoint.prod.sh
RUN chmod +x  $APP_HOME/entrypoint.prod.sh

# schedule editor
COPY eventyay/webapp/schedule-editor eventyay/webapp/schedule-editor
RUN npm ci --prefix=eventyay/webapp/schedule-editor
RUN OUT_DIR=/home/app/web/eventyay/data/compiled-frontend npm run build --prefix=eventyay/webapp/schedule-editor
# schedule widget
COPY eventyay/webapp/schedule eventyay/webapp/schedule
RUN npm ci --prefix=eventyay/webapp/schedule
RUN OUT_DIR=/home/app/web/eventyay/data/compiled-frontend npm run build --prefix=eventyay/webapp/schedule
# Video SPA app
COPY eventyay/webapp/video eventyay/webapp/video
RUN npm ci --prefix=eventyay/webapp/video
RUN OUT_DIR=/home/app/web/eventyay/data/compiled-frontend npm run build --prefix=eventyay/webapp/video
# esbuild needed by Django-Compressor
RUN npm install -g esbuild

# chown all the files to the app user
RUN chown -R app:app $APP_HOME

# Copy the Python environment from the builder
# Note: The venv path in the builder must match the one in runner.
COPY --from=builder --chown=app:app $APP_HOME/.venv $APP_HOME/.venv

# change to the app user
USER app

# Expose virtual env
ENV VIRTUAL_ENV="$APP_HOME/.venv"
ENV PATH="$APP_HOME/.venv/bin:$PATH"
ENV EVY_RUNNING_ENVIRONMENT=production


RUN python manage.py compilemessages -i .venv
RUN python manage.py compilejsi18n
RUN python manage.py collectstatic --noinput
#RUN python manage.py compress

# Now all the files are in $APP_HOME/eventyay/static.dist
# but this will be overloaded with a shared volume
RUN mkdir $APP_HOME/eventyay/static.dist.backup && \
    mv $APP_HOME/eventyay/static.dist/* $APP_HOME/eventyay/static.dist.backup

# Create .secrets to suppress warnings about missing directory
RUN mkdir -p $APP_HOME/.secrets

# run entrypoint.prod.sh
ENTRYPOINT ["/home/app/web/entrypoint.prod.sh"]
